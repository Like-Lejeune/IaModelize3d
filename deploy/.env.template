# deploy/.env for compose.yaml: copy this file to deploy/.env, fill it in and keep it private (chmod 600; the repo's
# .gitignore and .dockerignore leave .env files out). Compose reads it twice: FW_DOMAIN and ORCA_APPIMAGE_URL for
# compose.yaml itself, and every line as the API's settings. All settings and their defaults: ../.env.example and
# server/formwright/config.py. Leave a number commented out rather than empty: an empty number stops the API at start.
# compose.yaml sets FW_PUBLIC_URL (https://FW_DOMAIN), FW_PROXY_HOPS=1 and FW_DATA_DIR=/app/data itself.

# The public name of this server. Its A record (and AAAA, if the VPS has IPv6) must point here before the first
# start: Caddy asks Let's Encrypt for the certificate over ports 80/443.
FW_DOMAIN=formwright.example.com

# Meta Model API
META_API_KEY=

# What everyone together may spend per day, in USD. Past 80 % of it the strongest designer is skipped, at 100 % only
# replays, sliders and downloads work. Anonymous visitors share FW_ANON_BUDGET_SHARE of it; sign-in links (judges,
# farm operators, the Telegram bot) keep the rest.
FW_DAILY_BUDGET_USD=10
# FW_ANON_BUDGET_SHARE=0.75
# FW_JOB_BUDGET_USD=0.60
# Let anonymous visitors (judges) pick Muse Wonder as the designer
# FW_DEMO_WONDER=1

# Muse Spark Open on Baseten: the independent critic, classification and English prompts. Empty: Muse Spark does
# those too.
FW_OPEN_BASE_URL=
FW_OPEN_API_KEY=
FW_OPEN_MODEL=
# e.g. FW_OPEN_BASE_URL=https://inference.baseten.co/v1 and FW_OPEN_MODEL=meta-models/muse-spark-open-1026
# FW_MODEL_CRITIC=meta-models/muse-spark-open-1026
# FW_OPEN_ROLES=critic,classify,english
# FW_OPEN_PRICE_IN_PER_M=0
# FW_OPEN_PRICE_OUT_PER_M=0

# Formwright Parts: tenge with the dollar figure at this fixed rate, and the farm's OrcaSlicer preset until
# scripts/shop_seed.py registers its printer
# FW_USD_KZT=520
# FW_FARM_PRESET=bambu-lab-a1-0-4-nozzle

# Telegram bot. It long-polls, so one token runs in one place: blank it on every other server that has it.
FW_TELEGRAM_TOKEN=

# OrcaSlicer, built into the image: compose.yaml takes v2.4.2 (the version the farm's quotes were calibrated on)
# unless this says otherwise. Empty builds without a slicer: customers then see the instant range only.
# ORCA_APPIMAGE_URL=
