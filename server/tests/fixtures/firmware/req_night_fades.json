  "firmware": {
   "lang": "arduino",
   "files": {
    "night_light.ino": "#include <Adafruit_NeoPixel.h>\n#define PIR_PIN D3\n#define LDR_PIN D1\n#define BTN_PIN D2\n#define LED_PIN D10\n#define NUM_LEDS 4\nAdafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);\nint mode = 0;\nunsigned long lightUntil = 0;\nunsigned long lastBtn = 0;\nint brightness = 0;\nvoid setup(){\n  pinMode(PIR_PIN, INPUT);\n  pinMode(BTN_PIN, INPUT_PULLUP);\n  pinMode(LDR_PIN, INPUT);\n  strip.begin(); strip.clear(); strip.show();\n}\nbool isDark(){ int v=analogRead(LDR_PIN); return v>2000; }\nvoid loop(){\n  if(digitalRead(BTN_PIN)==LOW && millis()-lastBtn>500){\n    lastBtn=millis(); mode=(mode+1)%3; strip.fill(strip.Color(0,50,0)); strip.setBrightness(80); strip.show(); delay(150);\n  }\n  bool pir=digitalRead(PIR_PIN);\n  unsigned long now=millis();\n  if(mode==0){\n    if(pir && isDark()) lightUntil=now+30000;\n    if(now < lightUntil){\n      brightness=80;\n      strip.setBrightness(brightness); strip.fill(strip.Color(255,140,40)); strip.show();\n    } else if(brightness>0){\n      // плавное затухание\n      brightness--;\n      strip.setBrightness(brightness); strip.fill(strip.Color(255,140,40)); strip.show();\n      delay(20);\n    } else { strip.clear(); strip.show(); }\n  } else if(mode==1){ brightness=80; strip.setBrightness(brightness); strip.fill(strip.Color(255,140,40)); strip.show(); }\n  else { brightness=0; strip.clear(); strip.show(); }\n  delay(50);\n}\n"
   },
   "notes": "Плата XIAO ESP32-C3, Adafruit NeoPixel, пины D3/D1/D2/D10, плавное затухание реализовано"
  }
